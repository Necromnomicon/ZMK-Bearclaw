      hold-trigger-on-release;
    }; 
    mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
  
    */
  };
  

  combos {
    compatible = "zmk,combos";
      //HORIZANTAL COMBOS

    combo_reset {
      timeout-ms = <150>;
      key-positions = <0 9>;
      bindings = <&sys_reset>;
    };

    combo_bootloader {
      timeout-ms = <150>;
      key-positions = <20 29>;
      bindings = <&bootloader>;
    };

    combo_forward_tab {
      timeout-ms = <50>;
      key-positions = <2 3>;
      bindings = <&kp RC(TAB)>;
    };

    combo_backward_tab {
      timeout-ms = <50>;
      key-positions = <1 2>;
      bindings = <&kp RS(RC(TAB))>;
    };

    combo_tab {
      timeout-ms = <50>;
      key-positions = <21 22>;
      bindings = <&kp TAB>;
    };

    combo_esc {
      timeout-ms = <50>;
      key-positions = <22 23>;
      bindings = <&kp ESC>;
    };

    combo_delete {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&kp DEL>;
    };

    combo_backspace {
      timeout-ms = <50>;
      key-positions = <27 28>;
      bindings = <&kp BSPC>;
    };

    combo_enter {
      timeout-ms = <50>;
      key-positions = <26 27>;
      bindings = <&kp ENTER>;
    };

    combo_semi {
      timeout-ms = <50>;
      key-positions = <26 27 28>;
      bindings = <&kp SEMI>;
    };

    combo_game {
      timeout-ms = <100>;
      key-positions = <24 25>;
      bindings = <&tog GAME>;
    };

    combo_capsword {
      timeout-ms = <100>;
      key-positions = <23 26>;
      bindings = <&caps_word>;
    };


  };

  keymap {
    compatible = "zmk,keymap";

    base_layer {
      display-name = "GRAPHITE";
      bindings = <
        &kp B  &kp L  &kp D  &kp W  &kp Z                &kp APOS  &kp F  &kp O      &kp U    &kp J
        &kp N  &kp R  &kp T  &kp S  &kp G                &kp Y     &kp H  &kp A      &kp E    &kp I 
        &kp Q  &kp X  &kp M  &kp C  &kp V                &kp K     &kp P  &kp COMMA  &kp DOT  &kp SLASH   
                      &sl SYMB  &sl NAVI &sk LSHIFT    &kp SPACE  &sl NUMB  &sl SYMB
      >;
    };

    navi_layer {
      display-name = "NAVIGATE";
      bindings = <
        &kp 1     &kp 2        &kp 3      &kp 4       &kp 5            &kp 6 &kp 7     &kp 8 &kp 9  &kp 0
        &sk LGUI  &sk LALT     &sk LCTRL  &sk LSHIFT  &kp PSCRN        &none &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT 
        &kp CAPS  &kp LC(TAB)  &kp TAB    &kp ESC     &kp INSERT       &none &kp HOME  &kp PG_DN &kp PG_UP  &kp END   
                                &sl SYMB  &to NUMB  &sk LSHIFT    &to BASE  &sl NUMB  &sl SYMB
      >;
    };


    numb_layer {
      display-name = "NUMBER";
      bindings = <
        &kp PLUS  &kp 7  &kp 8  &kp 9  &kp STAR             &none     &none      &none     &none     &kp SEMI  
        &kp MINUS &kp 4  &kp 5  &kp 6  &kp SLASH            &none     &sk RSHIFT &sk RCTRL &sk RALT  &sk RGUI  
        &kp DOT   &kp 1  &kp 2  &kp 3  &kp COMMA            &kp EQUAL &kp ENTER  &kp BSPC  &kp LC(BSPC)  &kp DEL
                          &sl SYMB  &sl NAVI  &kp 0    &to BASE  &to NAVI  &sl SYMB
      >;
    };


    symb_layer {
      display-name = "SYMBOL";
      bindings = <
        &kp EXCL  &kp AT &kp HASH &kp DLLR &kp PERCENT             &kp CARET  &kp AMPS    &kp STAR   &kp UNDER  &kp SEMI
        &kp GRAVE &kp LT &kp LBRC &kp LPAR &kp LBKT                &kp COLON  &sk LSHIFT  &sk LCTRL  &sk LALT   &sk LGUI 
        &kp TILDE &kp GT &kp RBRC &kp RPAR &kp RBKT                &kp PIPE   &kp MINUS   &kp EQUAL  &kp PLUS   &kp BACKSLASH   
                          &sl SYMB  &sl NAVI  &sk LSHIFT    &kp SPACE  &sl NUMB   &sl FUNC
      >;
    };

    func_layer {
      display-name = "FUNCTION";
      bindings = <
        &kp F10 &kp F7 &kp F8 &kp F9 &kp F22                &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR_ALL &bt BT_CLR
        &kp F11 &kp F4 &kp F5 &kp F6 &kp F23                &kp C_MUTE &sk LSHIFT &sk LCTRL    &sk LALT &sk LGUI 
        &kp F12 &kp F1 &kp F2 &kp F3 &kp F24                &kp C_PP   &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT   
                          &sl SYMB  &sl NAVI  &sk LSHIFT    &kp SPACE  &sl NUMB  &sl SYMB
      >;
    };

    game_layer {
      display-name = "GAMING";
      bindings = <
        &kp T      &kp Q  &kp W  &kp E  &kp R                &kp Y     &kp U  &kp I      &kp O    &kp P
        &kp LSHIFT &kp A  &kp S  &kp D  &kp F                &kp H     &kp J  &kp K      &kp L    &kp ENTER 
        &kp LCTRL  &kp Z  &kp X  &kp C  &kp V                &kp N     &kp M  &kp COMMA  &kp DOT  &kp SLASH   
                        &kp B  &lt G GAME2 &kp SPACE         &kp SPACE  &none  &sl SYMB
      >;
    };

    game2_layer {
      display-name = "GAME_2";
      bindings = <
        &kp 6        &kp 7  &kp 8  &kp  9 &kp 0               &kp Y     &kp U  &kp I      &kp O    &kp P 
        &mt LSHIFT 4 &kp 3  &kp 2  &kp 1  &kp 5               &kp H     &kp J  &kp K      &kp L    &kp ENTER
        &mt LCTRL F4 &kp F3 &kp F2 &kp F3 &kp F5              &kp N     &kp M  &kp COMMA  &kp DOT  &kp SLASH  
                        &kp B &trans  &kp SPACE              &kp SPACE  &sl NUMB  &sl SYMB
      >;
    };

  };

};
